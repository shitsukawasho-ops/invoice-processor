// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 組織（テナント）テーブル
model Organization {
  id        String   @id @default(cuid())
  name      String   // 組織名
  slug      String   @unique // URLスラッグ
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins            Admin[]
  properties        Property[]
  staff             Staff[]
  settings          Setting[]
  lineRegistrations LineRegistration[]
  processedEmails   ProcessedEmail[]
}

// 管理者テーブル
model Admin {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  passwordHash   String
  name           String
  isMaster       Boolean      @default(false) // マスターアカウント（全会社管理）
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// 物件テーブル
model Property {
  id                      String                    @id @default(cuid())
  organizationId          String
  name                    String
  address                 String
  checkoutTime            String                    @default("11:00") // デフォルトチェックアウト時刻
  cleaningDurationMinutes Int                       @default(120) // 清掃所要時間（分）
  cleaningFee             Int                       @default(5000) // 清掃報酬（円）
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaningTasks           CleaningTask[]
  staffAssignments        StaffPropertyAssignment[]

  @@index([organizationId])
}

// 清掃スタッフテーブル
model Staff {
  id                  String                    @id @default(cuid())
  organizationId      String
  name                String
  lineUserId          String?                   @unique // LINE User ID
  phone               String?
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyAssignments StaffPropertyAssignment[]
  cleaningTasks       CleaningTask[]
  notifications       NotificationQueue[]

  @@index([organizationId])
}

// スタッフ-物件割当テーブル（多対多）
model StaffPropertyAssignment {
  id         String   @id @default(cuid())
  staffId    String
  propertyId String
  createdAt  DateTime @default(now())
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([staffId, propertyId])
}

// 清掃タスクテーブル
model CleaningTask {
  id                    String              @id @default(cuid())
  propertyId            String
  staffId               String? // 担当スタッフ（確定時に設定）
  cleaningDate          DateTime // 清掃予定日
  checkoutTime          String // チェックアウト時刻
  status                String              @default("pending") // pending, notifying, confirmed, completed, cancelled
  externalReservationId String? // 外部予約ID（AirHost等）
  guestCheckoutDate     DateTime? // ゲストチェックアウト日時
  cleaningFee           Int // 清掃報酬
  notificationSentAt    DateTime? // 通知送信日時
  acceptedAt            DateTime? // スタッフ受諾日時
  completedAt           DateTime? // 清掃完了日時
  notes                 String? // 備考
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  property              Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  staff                 Staff?              @relation(fields: [staffId], references: [id], onDelete: SetNull)
  notifications         NotificationQueue[]

  @@index([cleaningDate])
  @@index([status])
}

// 通知キューテーブル
model NotificationQueue {
  id             String       @id @default(cuid())
  cleaningTaskId String
  staffId        String
  status         String       @default("scheduled") // scheduled, pending, sent, accepted, declined, expired
  scheduledAt    DateTime // 通知予定日時
  sentAt         DateTime? // 実際の送信日時
  respondedAt    DateTime? // 応答日時
  lineMessageId  String? // LINE メッセージID
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cleaningTask   CleaningTask @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledAt])
}

// システム設定テーブル
model Setting {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

// LINE登録会話状態テーブル
model LineRegistration {
  id             String        @id @default(cuid())
  organizationId String?
  lineUserId     String        @unique // LINE User ID
  state          String        @default("waiting_name") // waiting_name, waiting_reading, waiting_phone, completed
  name           String? // 入力された名前
  nameReading    String? // ふりがな
  phone          String? // 電話番号
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// 処理済みメール追跡テーブル
model ProcessedEmail {
  id             String       @id @default(cuid())
  organizationId String
  emailId        String       // Gmail Message ID
  subject        String?
  processedAt    DateTime     @default(now())
  success        Boolean
  taskId         String?      // 作成されたタスクID（成功時）
  error          String?      // エラーメッセージ（失敗時）
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, emailId])
  @@index([organizationId])
  @@index([processedAt])
}

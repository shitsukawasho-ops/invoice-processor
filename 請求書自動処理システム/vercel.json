{
    "version": 2,
    "routes": [
        {
            "src": "/api/cron/process-emails",
            "dest": "api/cron/process-emails.py"
        },
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/process-emails",
            "schedule": "*/10 * * * *"
        }
    ],
    "env": {
        "PYTHONUNBUFFERED": "1"
    }
}